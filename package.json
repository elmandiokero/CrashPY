{
  "name": "crashpy",
  "version": "1.0.0",
  "private": true,
  "description": "CrashPY - juego Crash en tiempo real en guaraníes (PYG) con provably fair, chat y panel de administración",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "reset-admin": "node server/reset-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
