# Copiá este archivo como ".env" y ajustá lo que necesites.
# Todo lo demás (apuestas mínimas/máximas, datos bancarios, etc.) se configura desde el panel de admin.

# Puerto donde corre el servidor (el túnel de Cloudflare apunta acá)
PORT=3000

# Usuario y contraseña del administrador que se crea la PRIMERA vez que arranca.
# Si dejás ADMIN_PASS vacío se genera una contraseña aleatoria y se muestra en la consola.
ADMIN_USER=admin
ADMIN_PASS=

# Ventaja de la casa (%) de la primera cadena de hashes. 3 = RTP 97% (como Aviator).
# Después se puede cambiar desde el panel generando una cadena nueva.
HOUSE_EDGE=3

# Cantidad de rondas por cadena de hashes (1.000.000 ≈ 10 meses de juego continuo)
CHAIN_LENGTH=1000000

# Carpeta donde se guarda la base de datos y los comprobantes
DATA_DIR=data
